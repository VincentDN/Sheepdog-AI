{
  "manifest_version": 3,
  "name": "Sheepdog",
  "version": "1.0.0",
  "description": "Lets the Sheepdog service nudge your AI agents in Claude and ChatGPT tabs.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sheepdog"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
